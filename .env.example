# Google Gemini API Key (Required for LLM and RAG responses)
GOOGLE_API_KEY=your_google_api_key_here

# SerpAPI Key (Required for Web RAG Google search)
SERPAPI_KEY=your_serpapi_key_here

# Redis Configuration (defaults to localhost when running locally, 'redis' inside Docker)
REDIS_HOST=redis
REDIS_PORT=6379
